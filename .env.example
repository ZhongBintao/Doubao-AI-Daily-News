# AI Daily News Studio - 环境配置
# 云电脑原生模式默认使用豆包文生语音（text_to_audio_plus + 固定音色描述），
# 无需任何 API 密钥，也不需要参考音频。Azure/Gemini 仅作兼容保留。

# 语音合成模式与音色描述在代码中定义（单一来源）：
#   ai_morning_brief/config.py -> DOUBAO_TTS_VOICE_PROFILE / DEFAULT_TTS_MODE
# 本文件不再声明 TTS 模式（旧版 DOUBAO_TTS_MODE 等键从未被代码读取，已移除）。

# 成片语速：渲染完成后整片提速（画面+音频一起，音高不变），默认 1.25。
# 设为 1.0 按自然速度交付；范围 1.0-2.0。加速失败会降级交付 1.0x 并记警告。
# AI_BRIEF_OUTPUT_TEMPO=1.25

# 可选：本地 ASR 引擎（字幕时间戳用）。未安装时字幕回退比例估算。
# mlx-whisper（Apple Silicon）或 faster-whisper，二选一即可。
# AI_BRIEF_ASR_ENGINE=mlx-whisper
# AI_BRIEF_ASR_MODEL=small

# Azure Speech（可选，兼容保留；云电脑原生模式不需要）
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia

# Gemini TTS（可选）
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_API_KEY=
