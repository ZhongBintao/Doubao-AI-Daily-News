# AI Daily News Studio - 环境配置
# 使用豆包 TTS 时，以下 Azure/Gemini 密钥留空即可。
# 如需使用 Azure TTS（精准字幕），填写 AZURE_SPEECH_KEY 和 AZURE_SPEECH_REGION。

# Azure Speech（可选，精准字幕对齐）
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia

# Gemini TTS（可选）
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_API_KEY=

# 豆包配置（本项目使用对话内语音合成，无需 API key）
DOUBAO_TTS_PROVIDER=doubao
DOUBAO_TTS_ALIGNMENT=proportional
