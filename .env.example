# AI Daily News Studio - 环境配置
# 云电脑原生模式默认使用豆包语音克隆（audio_to_audio_plus + example-audio.mp3），
# 无需任何 API 密钥。Azure/Gemini 仅作兼容保留。

# 豆包语音克隆（默认生产声道）
DOUBAO_TTS_MODE=voice-clone
DOUBAO_VOICE_CLONE_REFERENCE=example-audio.mp3
DOUBAO_TTS_ALIGNMENT=proportional

# Azure Speech（可选，精准字幕对齐；云电脑原生模式不需要）
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=southeastasia

# Gemini TTS（可选）
# GOOGLE_AI_STUDIO_API_KEY=
# GEMINI_API_KEY=
